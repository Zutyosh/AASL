# Toolchain for building Unilux patch bundles: Wine (64-bit, MinGW PE side)
# and ffmpeg with dav1d. Arch is used because its packages track the
# versions Proton builds against closely.
FROM docker.io/library/archlinux:base-devel

RUN pacman -Syu --noconfirm --needed \
        git curl tar xz python nasm mingw-w64-gcc autoconf bison flex perl \
        gnutls dav1d bzip2 libxkbcommon vulkan-headers vulkan-icd-loader \
        freetype2 fontconfig libunwind patch ffmpeg \
    && pacman -Scc --noconfirm

COPY build.sh /usr/local/bin/unilux-build-patches
RUN chmod +x /usr/local/bin/unilux-build-patches
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/unilux-build-patches"]
